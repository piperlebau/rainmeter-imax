; pipOS theme :: HC AMBER
; 14 design-system roles as Rainmeter hex colours. Referenced as e.g. FontColor=#fg#.
; The PHOSPHOR control cycles themes by rewriting @IncludeTheme to #NextTheme#.
[Variables]
ThemeName=HC AMBER
NextTheme=mono-white
bg=000000
bezel=0B0800
fg=FFC53D
dim=9A6E00
faint=5A4000
frame=B58200
key=FFA500
str=FFDD77
num=FFF0B3
path=FFB733
kw=FFE680
ok=3BFF6A
warn=FF9500
err=FF4A3D
sel=2A1D00
ink=000000
; glow = fg colour at this alpha (hex), used by baked PNG bloom / text shadow tuning
glowAlpha=72
