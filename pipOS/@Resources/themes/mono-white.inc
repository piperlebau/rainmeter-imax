; pipOS theme :: MONO WHITE
; 14 design-system roles as Rainmeter hex colours. Referenced as e.g. FontColor=#fg#.
; The PHOSPHOR control cycles themes by rewriting @IncludeTheme to #NextTheme#.
[Variables]
ThemeName=MONO WHITE
NextTheme=tokyo-night
bg=000000
bezel=080808
fg=FFFFFF
dim=909090
faint=4A4A4A
frame=B0B0B0
key=E0E0E0
str=FFFFFF
num=F0F0F0
path=D0D0D0
kw=FFFFFF
ok=FFFFFF
warn=C0C0C0
err=FFFFFF
sel=222222
ink=000000
; glow = fg colour at this alpha (hex), used by baked PNG bloom / text shadow tuning
glowAlpha=56
