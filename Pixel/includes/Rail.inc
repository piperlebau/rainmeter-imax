; Rail.inc — W12a workspace tab rail (5 tabs). Active tab inverse-filled. LEDs live in pipOS.ini.

[Ws1Fill]
Meter=Shape
Shape=Rectangle 50,700,231,74,3 | FillColor #Key# | StrokeWidth 0

[Ws1Num]
Meter=String
MeterStyle=sSub
FontColor=#InkOnFill#
FontSize=10
X=66
Y=710
Text=01

[Ws1Name]
Meter=String
MeterStyle=sBtn
FontColor=#InkOnFill#
FontSize=20
StringAlign=CENTER
X=165
Y=730
StringStyle=BOLD
Text=DEV

[Ws1Sub]
Meter=String
MeterStyle=sSub
FontColor=#InkOnFill#
StringAlign=CENTER
X=165
Y=754
Text=6 APPS

